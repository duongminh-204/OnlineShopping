@{
    ViewData["Title"] = "Mua hàng thành công";
    Layout = "~/Views/Shared/Layout/Front/_Layout.cshtml";
}
<div class="container py-5 mt-5 text-center" style="font-family: 'Roboto', sans-serif;">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-lg rounded-4 p-5">
                <div class="mb-4">
                    <i class="bi bi-check-circle-fill text-success" style="font-size: 5rem;"></i>
                </div>
                <h2 class="fw-bold text-dark mb-3">Đặt Hàng Thành Công!</h2>
                <p class="text-muted fs-5 mb-4">
                    Cảm ơn bạn đã tin tưởng và mua sắm tại cửa hàng của chúng tôi. 
                    Đơn hàng của bạn đang được xử lý và sẽ sớm được giao đến bạn.
                </p>
                <div class="d-flex justify-content-center gap-3 mt-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark px-4 py-2 rounded-pill fw-medium">
                        <i class="bi bi-arrow-left me-2"></i>Tiếp tục mua sắm
                    </a>
                    <a asp-controller="Order" asp-action="History" class="btn btn-dark px-4 py-2 rounded-pill fw-medium shadow-sm">
                        <i class="bi bi-box-seam me-2"></i>Xem đơn hàng của tôi
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>