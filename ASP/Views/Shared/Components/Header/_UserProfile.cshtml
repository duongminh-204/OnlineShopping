@model ASP.Models.Admin.Accounts.ApplicationUser

<div class="profile-shell">
    <div class="profile-card shadow-sm">
        <div class="profile-hero">
            <div class="profile-avatar-wrap">
                <img src="@(string.IsNullOrWhiteSpace(Model.Avatar) ? "data:image/svg+xml;charset=UTF-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='200' height='200'%3E%3Crect width='200' height='200' rx='100' fill='%23f3f3f3'/%3E%3Ccircle cx='100' cy='82' r='38' fill='%23111'/%3E%3Cpath d='M40 166c12-32 46-48 60-48s48 16 60 48' fill='%23111'/%3E%3C/svg%3E" : Url.Content($"~/assets/users/{Model.Avatar}"))"
                     alt="@(Model.FullName ?? Model.UserName)"
                     class="profile-avatar"
                     onerror="this.onerror=null;this.src='data:image/svg+xml;charset=UTF-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='200' height='200'%3E%3Crect width='200' height='200' rx='100' fill='%23f3f3f3'/%3E%3Ccircle cx='100' cy='82' r='38' fill='%23111'/%3E%3Cpath d='M40 166c12-32 46-48 60-48s48 16 60 48' fill='%23111'/%3E%3C/svg%3E';" />
            </div>
            <div class="profile-identity">
                <h4 class="mb-1 fw-bold">@(Model.FullName ?? "Chưa cập nhật")</h4>
                <p class="mb-2 text-white-50">@Model.UserName</p>
                <span class="badge bg-light text-dark">Tài khoản cá nhân</span>
            </div>
        </div>

        <div class="row g-3 mt-1">
            <div class="col-12">
                <div class="info-list">
                    <div class="info-item">
                        <div class="info-icon"><i class="bi bi-at"></i></div>
                        <div>
                            <small class="text-muted">Username</small>
                            <div class="fw-semibold">@Model.UserName</div>
                        </div>
                    </div>

                    <div class="info-item alt">
                        <div class="info-icon"><i class="bi bi-person"></i></div>
                        <div>
                            <small class="text-muted">Họ tên</small>
                            <div class="fw-semibold">@(Model.FullName ?? "Chưa cập nhật")</div>
                        </div>
                    </div>

                    <div class="info-item">
                        <div class="info-icon"><i class="bi bi-envelope"></i></div>
                        <div>
                            <small class="text-muted">Email</small>
                            <div>
                                <a href="mailto:@Model.Email" class="text-dark text-decoration-none fw-semibold">@Model.Email</a>
                            </div>
                        </div>
                    </div>

                    <div class="info-item alt">
                        <div class="info-icon"><i class="bi bi-telephone"></i></div>
                        <div>
                            <small class="text-muted">Số điện thoại</small>
                            <div class="fw-semibold">@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "Chưa cập nhật" : Model.PhoneNumber)</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="text-center mt-3">
        <button type="button" class="btn profile-btn-secondary px-4" data-bs-dismiss="modal">
            <i class="bi bi-x-circle me-1"></i> Đóng
        </button>
    </div>
</div>

<style>
    .profile-shell {
        padding: 4px 2px;
        font-family: DaxMedium, Arial, Helvetica, sans-serif;
    }

    .profile-card {
        border: 1px solid #d9d9d9;
        border-radius: 18px;
        overflow: hidden;
        background: #ffffff;
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.06);
    }

    .profile-hero {
        background: linear-gradient(135deg, #111111 0%, #2f2f2f 100%);
        color: #fff;
        padding: 24px;
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .profile-avatar-wrap {
        flex-shrink: 0;
    }

    .profile-avatar {
        width: 92px;
        height: 92px;
        object-fit: cover;
        border-radius: 50%;
        border: 4px solid rgba(255,255,255,0.9);
        box-shadow: 0 8px 20px rgba(0,0,0,0.16);
    }

    .profile-btn-secondary {
        background: #fff;
        color: #111111;
        border: 1px solid #bfbfbf;
        font-weight: 600;
    }

    .profile-btn-secondary:hover {
        background: #f3f3f3;
        color: #111111;
        border-color: #8c8c8c;
    }

    .profile-identity h4 {
        margin-bottom: 2px;
    }

    .info-list {
        padding: 12px 16px 16px;
        display: grid;
        gap: 10px;
    }

    .info-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 14px;
        border-radius: 12px;
        background: #f7f7f7;
        border: 1px solid #e2e2e2;
        color: #222222;
    }

    .info-item.alt {
        background: #ffffff;
    }

    .info-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #111111;
        color: #ffffff;
        font-size: 1rem;
    }
</style>

